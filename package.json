{
  "name": "project-phantom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based 3D tactical multiplayer FPS with LAN rooms",
  "workspaces": [
    "apps/shared",
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:lan": "concurrently -k -n server,client -c red,cyan \"npm:dev:server\" \"npm:dev:client -- --host 0.0.0.0\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config apps/client/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node apps/server/dist/index.js",
    "start:lan": "npm run build && node apps/server/dist/index.js --lan",
    "serve:lan": "node apps/server/dist/index.js --lan",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/client --noEmit",
    "lint": "eslint .",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:royale": "node scripts/e2e-royale.mjs",
    "tour": "node scripts/tour.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright-core": "^1.64.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
